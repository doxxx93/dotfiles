# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
	name = doxxx93
	email = doxxx93@gmail.com
	signingkey = /Users/doxxx/.ssh/id_ed25519.pub
[commit]
	gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[includeIf "gitdir:~/doxxx/"]
  path = ~/.gitconfig-doxxx
[gpg]
	format = ssh
[gpg "ssh"]
	allowedsignersfile = /Users/doxxx/.ssh/allowed_signers
[credential "https://github.com"]
	helper = !$HOME/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !$HOME/.local/share/mise/shims/gh auth git-credential
[core]
	excludesfile = /Users/doxxx/.gitignore_global
[pull]
	rebase = true
[advice]
	addIgnoredFile = false
