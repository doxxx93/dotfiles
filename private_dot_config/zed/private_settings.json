// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": true,
  "markdown_preview": {
    "open_markdown_files_in_preview": true
  },
  "cli_default_open_behavior": "existing_window",
  "tabs": {
    "git_status": true
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true
  },
  "agent": {
    "default_model": {
      "provider": "amazon-bedrock",
      "model": "claude-opus-4-5"
    },
    "inline_assistant_model": {
      "provider": "amazon-bedrock",
      "model": "claude-opus-4-5"
    },
    "model_parameters": []
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "scroll_beyond_last_line": "off",
  "base_keymap": "JetBrains",
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 14,
  "buffer_font_family": "SF Mono",
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono"],
  "buffer_font_size": 13,
  "buffer_font_weight": 400,
  "buffer_line_height": { "custom": 1.2 },
  "project_panel": {
    "dock": "right"
  },
  "terminal": {
    "dock": "bottom",
    "font_family": "SF Mono",
    "font_fallbacks": ["Symbols Nerd Font Mono"],
    "font_size": 13,
    "font_weight": 400,
    "line_height": { "custom": 1.2 }
  },
  "auto_install_extensions": {
    "base16": true
  },
  "theme": {
    "mode": "system",
    "light": "Base16 Google Light",
    "dark": "Base16 Google Dark"
  }
}
