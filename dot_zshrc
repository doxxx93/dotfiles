# Oh My Zsh 설정
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="miloshadzic"
plugins=(git)
source $ZSH/oh-my-zsh.sh

# GPG_TTY만 여기 유지 — tty는 대화형 셸마다 달라 매번 재평가 필요 (나머지 env/PATH는 .zshenv/.zprofile)
export GPG_TTY=$(tty)

# 툴 활성화
eval "$(mise activate zsh)"

# GitHub MCP가 Bearer 헤더로 읽는 env. 값은 keyring의 gh 토큰에서 매번 가져옴 (평문 저장 안 함)
# ponytail: `gs`로 계정 전환 시 새 셸부터 반영. 즉시 필요하면 이 줄만 재실행
export GITHUB_PERSONAL_ACCESS_TOKEN=$(gh auth token 2>/dev/null)
# gh/tailscale 완성은 공식 권장대로 ~/.oh-my-zsh/custom/completions/_gh, _tailscale 로 fpath에 배치됨
# (compinit이 lazy-load — 매 시작 eval 대신). 툴 업그레이드 후 재생성: gh completion -s zsh > ...

# 플러그인
source /opt/homebrew/opt/zsh-fast-syntax-highlighting/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# 자동완성 (compinit은 oh-my-zsh.sh가 캐시와 함께 이미 실행함 — 중복 호출 금지)
autoload -U +X bashcompinit && bashcompinit
complete -o nospace -C terraform terraform

# 별칭
alias z='cd ~/work'
alias k=kubectl
alias tf="terraform"
alias vault='cd ~/personal/vault'
alias tree='eza --tree'
alias ls="eza --icons=auto"

# Warp 함수
warp() {
  if [[ $# -eq 0 || "$1" == "." ]]; then
    # 인수가 없거나 현재 디렉토리인 경우
    open -a "Warp" "$(pwd)"
  elif [[ -d "$1" ]]; then
    # 전달된 경로가 존재하는 디렉토리인 경우
    open -a "Warp" "$1"
  else
    # 절대 경로로 변환하여 시도
    local abs_path=$(realpath "$1" 2>/dev/null)
    if [[ -d "$abs_path" ]]; then
      open -a "Warp" "$abs_path"
    else
      echo "Error: Directory '$1' does not exist"
      return 1
    fi
  fi
}

alias gs='gh auth switch'

# Auto-Warpify
[[ "$-" == *i* ]] && printf 'P$f{"hook": "SourcedRcFileForWarp", "value": { "shell": "zsh", "uname": "Darwin", "tmux": false }}�' 

# Jira API credentials
[ -f ~/.config/jira/.env ] && source ~/.config/jira/.env

# Upgrade brew + mise in parallel, then clean up
up() {
  local brew_pid mise_pid failed=0
  brew update && brew upgrade -y && brew cleanup --prune=all &
  brew_pid=$!
  mise upgrade && mise prune -y &
  mise_pid=$!
  wait "$brew_pid" || { echo "❌ brew failed" >&2; failed=1; }
  wait "$mise_pid" || { echo "❌ mise failed" >&2; failed=1; }
  (( failed == 0 )) || return 1
  echo "✅ brew + mise up to date"
}
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"
